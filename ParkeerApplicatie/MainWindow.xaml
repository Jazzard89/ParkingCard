<Window x:Class="ParkeerApplicatie.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parkeerregistratie" Width="1200" SizeToContent="Height"
        Background="#DEDEDE">

    <Window.Resources>
        <Style x:Key="RondeKnop" TargetType="Button">
            <Setter Property="Background" Value="#62A12B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="8" Grid.Row="0" Grid.Column="0">
                <Label Content="Naam"/>
                <TextBox x:Name="TxtNaam"/>
                <Label Content="Voornaam"/>
                <TextBox x:Name="TxtVoornaam"/>
            </StackPanel>

            <StackPanel Margin="8" Grid.Row="0" Grid.Column="1">
                <Label Content="Nummerplaat"/>
                <TextBox x:Name="TxtNummerplaat"/>
                <Label Content="Type wagen"/>
                <ComboBox x:Name="CmbTypeWagen">
                    <ComboBoxItem>Bestelwagen</ComboBoxItem>
                    <ComboBoxItem>Personenwagen</ComboBoxItem>
                    <ComboBoxItem>Vrachtwagen</ComboBoxItem>
                </ComboBox>
            </StackPanel>

            <StackPanel Margin="8" Grid.Row="1" Grid.Column="0">
                <Label Content="Firma"/>
                <TextBox x:Name="TxtFirma"/>
                <Label Content="Gsm nummer"/>
                <TextBox x:Name="TxtGsm"/>
            </StackPanel>

            <StackPanel Margin="8" Grid.Row="1" Grid.Column="1">
                <Label Content="Bestemming"/>
                <TextBox x:Name="TxtBestemming"/>
                <Label Content="Contactpersoon"/>
                <TextBox x:Name="TxtContactpersoon"/>
            </StackPanel>

            <StackPanel Margin="8" Grid.Row="2" Grid.Column="0">
                <Label Content="Datum"/>
                <DatePicker x:Name="DpDatum"/>
                <Label Content="Uur inrijden"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="TxtTijd" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" Content="Huidige tijd" Margin="5,0,0,0"
            Click="HuidigeTijd_Click"/>
                </Grid>
            </StackPanel>

            <StackPanel Margin="8" Grid.Row="2" Grid.Column="1">
                <Label Content="Dag kaart"/>
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="ChkDagkaart" Content="Ja" Margin="10 0"
                          Checked="CheckBox_Checked" Unchecked="CheckBox_Unchecked"/>
                    <CheckBox x:Name="ChkDagkaartNee" Content="Nee"
                              IsChecked="True"
                          Checked="CheckBox_Unchecked" Unchecked="CheckBox_Checked"/>
                </StackPanel>
                <Label Content="Locatie"/>
                <ComboBox x:Name="TxtLocatie">
                    <ComboBoxItem>Plant 1</ComboBoxItem>
                    <ComboBoxItem>Plant 2</ComboBoxItem>
                    <ComboBoxItem>Plant 3</ComboBoxItem>
                    <ComboBoxItem>Andere</ComboBoxItem>

                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" Content="Momenteel on site:"
           VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource RondeKnop}" Content="Annuleren" Click="Annuleren_Click"/>
                <Button Style="{StaticResource RondeKnop}" Content="Opslaan" Click="Opslaan_Click"/>
            </StackPanel>
        </Grid>

        <DataGrid x:Name="DgRegistraties"
          AutoGenerateColumns="False"
                  Height="300px"
          IsReadOnly="True"
          CanUserAddRows="False"
          SelectionMode="Single"
          GridLinesVisibility="Horizontal"
          AlternatingRowBackground="#F2F2F2"
          HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Firma" Binding="{Binding Firma}" Width="*"/>
                <DataGridTextColumn Header="Naam" Binding="{Binding Naam}" Width="*"/>
                <DataGridCheckBoxColumn Header="Dag kaart" Binding="{Binding DagKaart}" Width="Auto"/>
                <DataGridTextColumn Header="Tijd inrijden"
                            Binding="{Binding TijdInrijden, StringFormat=HH:mm}"
                            Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</Window>